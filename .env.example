# Copy to .env for a manual run; GitHub Actions uses repository secrets and variables.
SUPABASE_DB_URL=
GEMINI_API_KEY=
# Optional second key; requests alternate between the keys.
GEMINI_API_KEY_2=

AUDIT_MODEL=gemma-4-31b-it
AUDIT_DAILY_LIMIT=1000
AUDIT_MAX_MINUTES=90
AUDIT_BATCH_SIZE=10
AUDIT_MAX_BATCH_CHARS=24000
AUDIT_KEY_INTERVAL_MS=30000
# Requests one key carries at the same time (1-4).
AUDIT_KEY_CONCURRENCY=2
AUDIT_ATTEMPTS=5
